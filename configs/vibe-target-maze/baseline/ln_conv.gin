run.seed = 71
run.job_class = @TrainJob
    TrainJob.embed_dim = 128
    TrainJob.metric_name = 'L22'
    TrainJob.normalize = False
    TrainJob.trainset_path = 'data/vibe-target-maze/train'
    TrainJob.epochs = 20
    TrainJob.lr = 0.001
    TrainJob.loss_class = @BaselineContrastiveLoss
    TrainJob.base_model_class = @LNConvNet
        LNConvNet.input_network_class = @Embedding2D
            Embedding2D.n_states = 4
        LNConvNet.hidden_size = 32
        LNConvNet.block_depth = 4
    TrainJob.dataset_class = @ContrastiveDatasetNoSpecial
        ContrastiveDatasetNoSpecial.batch_size = 256
        ContrastiveDatasetNoSpecial.repetition_factor = 2
    TrainJob.metrics_job_class = @MetricsJob
        MetricsJob.validset_path = 'data/vibe-target-maze/valid'
        MetricsJob.validset_class = @ContrastiveDatasetNoSpecial
        MetricsJob.logger_class = @MultipleLoggers
            MultipleLoggers.default_log_freq = 1
            MultipleLoggers.advanced_frequencies = {
                'gif': 10,
            }
            MultipleLoggers.skip_first_metrics = ['gif']
            MultipleLoggers.wandb = False
        MetricsJob.solve_attempts = 512
        MetricsJob.n_gifs = 5
        MetricsJob.n_embed_plots = 5
        MetricsJob.checkpoint_models = 'haha...no'
        MetricsJob.env_class = @VectorizedTargetMaze
            VectorizedTargetMaze.grid_dim = 21
        MetricsJob.ve_class = @ManyGoalsValueEstimator