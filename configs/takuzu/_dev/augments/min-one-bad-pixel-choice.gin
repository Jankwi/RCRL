run.seed = 67
run.name = 'takuzu augment preview - min one bad pixel choice'
run.family = 'augment-preview'
run.tags = {'augment_type': 'min-one-bad-pixel-choice'}
run.job_class = @AugmentPreviewJob
    AugmentPreviewJob.dataset_path = 'data/takuzu-algo-order/valid'
    AugmentPreviewJob.n_renders = 4
    AugmentPreviewJob.save_dir = '/augment-previews/min-one-bad-pixel-choice'
    AugmentPreviewJob.aug = @MinOneBadPixelChoice()
        MinOneBadPixelChoice.default_temporal_dist = 3
    AugmentPreviewJob.env_class = @VectorizedTakuzu
        VectorizedTakuzu.n = 8
        VectorizedTakuzu.spec_mgr = None
