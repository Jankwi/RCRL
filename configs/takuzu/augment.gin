run.seed = 67
run.run_name = 'takuzu augment preview - bad random pixel choice'
run.run_family = 'augment-preview'
run.tags = {'augment_type': 'bad-random-pixel-choice'}
run.job_class = @AugmentPreviewJob
    AugmentPreviewJob.dataset_path = 'data/takuzu-sample'
    AugmentPreviewJob.n_renders = 4
    AugmentPreviewJob.save_dir = '/augment-previews/bad-random-pixel-choice'
    AugmentPreviewJob.aug = @BadRandomPixelChoice()
        BadRandomPixelChoice.k_flipped = 3
    AugmentPreviewJob.env_class = @VectorizedTakuzu
        VectorizedTakuzu.n = 8
        VectorizedTakuzu.spec_mgr = None
