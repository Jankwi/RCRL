run.seed = 71
run.name = 'relative crl with special padding on takuzu'
run.family = 'relative'
run.job_class = @TrainJob
    TrainJob.embed_dim = 64
    TrainJob.metric_name = 'L22'
    TrainJob.normalize = False
    TrainJob.dataset_dir = 'data/takuzu-split-sample'
    TrainJob.epochs = 1000
    TrainJob.lr = 3e-4
    TrainJob.loss_class = @ElementwiseRelativeLoss
    TrainJob.base_model_class = @LNConvNet
        LNConvNet.input_network_class = @Embedding2D
            Embedding2D.n_states = 3
        LNConvNet.hidden_size = 64
        LNConvNet.block_depth = 8
    TrainJob.spec_mgr_class = @SpecialStateManager
        SpecialStateManager.val = 255
        SpecialStateManager.shape = (8, 8)
        SpecialStateManager.dt_string = 'uint8'
    TrainJob.spec_model_wrapper_class = @SpecialStateModelWrapper
        SpecialStateModelWrapper.trainable_special = True
    TrainJob.dataset_class = @RelativeContrastiveDataset
        RelativeContrastiveDataset.batch_size = 512
        RelativeContrastiveDataset.aug_class = @AllBadPixelChoice
        RelativeContrastiveDataset.gamma = 0.9
        RelativeContrastiveDataset.negs_per_pos = 3
        RelativeContrastiveDataset.max_prev = 1
        RelativeContrastiveDataset.pad_special = True
    TrainJob.metrics_job_class = @MetricsJob
        MetricsJob.logger_class = @MultipleLoggers
            MultipleLoggers.default_log_freq = 25
            MultipleLoggers.wandb = True
            MultipleLoggers.skip_metrics = ['plot_embeds', 'state_dict', 'gif']
        MetricsJob.solved_rate_job_class = @SolvedRateJob
            SolvedRateJob.n_boards = 1024
            SolvedRateJob.frames_back = [1, 2, 4, 8, 12, 15, 20, 28, 35, 40]
        MetricsJob.n_gifs = 0
        MetricsJob.checkpoint_models = 'local'
        MetricsJob.env_class = @VectorizedTakuzu
            VectorizedTakuzu.n = 8
        MetricsJob.ve_class = @SingleGoalValueEstimator
