include 'configs/takuzu/explicit/common.gin'

run.name = 'relative crl on explicit trajs'
MetricsJob.checkpoint_dir = 'checkpoints/explicit/rcrl'
TrainJob.loss_class = @ElementwiseRelativeLoss
TrainJob.dataset_class = @RelativeContrastiveDataset
    RelativeContrastiveDataset.batch_size = 512
    RelativeContrastiveDataset.aug_class = @AllRandomPixelChoice
    RelativeContrastiveDataset.gamma = 0.9
    RelativeContrastiveDataset.negs_per_pos = 3
    RelativeContrastiveDataset.max_prev = 1
    RelativeContrastiveDataset.geom_type = 'clamped'