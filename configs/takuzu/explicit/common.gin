include 'configs/takuzu/explicit/network.gin'

run.seed = 67
run.family = 'explicit-takuzu'
run.job_class = @TrainJob
    TrainJob.embed_dim = 128
    TrainJob.epochs = 200
    TrainJob.lr = 3e-4
    TrainJob.base_model_class = @LNConvNet
    TrainJob.metrics_job_class = @MetricsJob
        MetricsJob.logger_class = @MultipleLoggers
            MultipleLoggers.default_log_freq = 25
            MultipleLoggers.wandb = True
            MultipleLoggers.skip_metrics = ['plot_embeds', 'gif']
        MetricsJob.solved_rate_job_class = @SolvedRateJob
            SolvedRateJob.n_boards = 200
            SolvedRateJob.frames_back = [1, 2, 4, 8, 12, 15, 20, 30, 40]
        MetricsJob.n_gifs = 0
        MetricsJob.checkpoint_models = 'local'
        MetricsJob.env_class = @ExplicitGoalTakuzu
            ExplicitGoalTakuzu.n = 8
        MetricsJob.ve_class = @SingleGoalValueEstimator
