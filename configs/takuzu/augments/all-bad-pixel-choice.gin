run.seed = 67
run.name = 'takuzu augment preview - all bad pixel choice'
run.family = 'augment-preview'
run.tags = {'augment_type': 'all-bad-pixel-choice'}
run.job_class = @AugmentPreviewJob
    AugmentPreviewJob.dataset_path = 'data/takuzu-sample'
    AugmentPreviewJob.n_renders = 4
    AugmentPreviewJob.save_dir = '/augment-previews/all-bad-pixel-choice'
    AugmentPreviewJob.aug = @AllBadPixelChoice()
        AllBadPixelChoice.default_temporal_dist = 3
    AugmentPreviewJob.env_class = @VectorizedTakuzu
        VectorizedTakuzu.n = 8
        VectorizedTakuzu.spec_mgr = None
