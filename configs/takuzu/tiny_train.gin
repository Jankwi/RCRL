run.seed = 67
run.run_name = 'takuzu tiny train'
run.job_class = @TrainJob
    TrainJob.embed_dim = 64
    TrainJob.metric_name = 'L2'
    TrainJob.normalize = False
    TrainJob.trainset_path = 'data/takuzu-sample'
    TrainJob.epochs = 10
    TrainJob.lr = 3e-4
    TrainJob.loss_class = @BaselineContrastiveLoss
    TrainJob.base_model_class = @LNConvNet
        LNConvNet.input_network_class = @Embedding2D
            Embedding2D.n_states = 3
        LNConvNet.hidden_size = 32
        LNConvNet.block_depth = 4
    TrainJob.spec_mgr_class = @SpecialStateManager
        SpecialStateManager.val = 255
        SpecialStateManager.shape = (8, 8)
        SpecialStateManager.dt_string = 'uint8'
    TrainJob.spec_model_wrapper_class = @SpecialStateModelWrapper
        SpecialStateModelWrapper.trainable_special = True
    TrainJob.dataset_class = @ContrastiveDatasetSpecialPadding
        ContrastiveDatasetSpecialPadding.batch_size = 256
        ContrastiveDatasetSpecialPadding.repetition_factor = 2
    TrainJob.metrics_job_class = @MetricsJob
        MetricsJob.validset_path = 'data/takuzu-sample'
        MetricsJob.validset_class = @ContrastiveDatasetSpecialPadding
        MetricsJob.logger_class = @MultipleLoggers
            MultipleLoggers.default_log_freq = 1
            MultipleLoggers.wandb = False
            MultipleLoggers.skip_metrics = ['plot_embeds', 'state_dict', 'gif']
        MetricsJob.solved_rate_job_class = @SolvedRateJob
            SolvedRateJob.n_boards = 256
            SolvedRateJob.frames_back = [1, 2]
        MetricsJob.n_gifs = 0
        MetricsJob.checkpoint_models = 'no..haha'
        MetricsJob.env_class = @VectorizedTakuzu
            VectorizedTakuzu.n = 8
        MetricsJob.ve_class = @SingleGoalValueEstimator