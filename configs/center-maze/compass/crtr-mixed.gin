include 'configs/center-maze/compass/common.gin'

run.name = 'CRTR (mixed trajectories)'
TrainJob.metric_name = 'L1'
TrainJob.normalize = False
MetricsJob.checkpoint_dir = 'checkpoints/compass/center-maze-crtr-mixed'
TrainJob.loss_class = @BaselineContrastiveLoss
TrainJob.dataset_class = @MixedDataset
    MixedDataset.batch_size = 512
    MixedDataset.geom_type = 'bounded'
    MixedDataset.different_lengths = True
