include 'configs/center-maze/explicit/common.gin'

run.name = 'CRTR'
TrainJob.metric_name = 'dot'
TrainJob.normalize = True
MetricsJob.checkpoint_dir = 'checkpoints/explicit/crtr'
TrainJob.loss_class = @BaselineContrastiveLoss
TrainJob.dataset_class = @ContrastiveDatasetNoSpecial
    ContrastiveDatasetNoSpecial.batch_size = 512
    ContrastiveDatasetNoSpecial.repetition_factor = 2
    ContrastiveDatasetNoSpecial.geom_type = 'clamped'
