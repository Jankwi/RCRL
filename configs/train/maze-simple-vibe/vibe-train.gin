run.job_class = @TrainJob
    TrainJob.embed_dim = 32
    TrainJob.metric_name = 'dot'
    TrainJob.normalize = True
    TrainJob.seed = 0
    TrainJob.trainset_path = 'data/maze-simple-vibe/train'
    TrainJob.validset_path = 'data/maze-simple-vibe/test'
    TrainJob.epochs = 30
    TrainJob.base_model_class = @BroNet
        BroNet.input_dim = 400
    TrainJob.logger_class = @StdOutLogger
        StdOutLogger.log_freq = 5
    TrainJob.dataset_class = @ContrastiveDatasetNoSpecial
        ContrastiveDatasetNoSpecial.batch_size = 256
        ContrastiveDatasetNoSpecial.repetition_factor = 2
    TrainJob.solver_class = @Solver
        Solver.games = 256
        Solver.env_class = @VectorizedQuarterMaze
            VectorizedQuarterMaze.grid_dim = 20
    TrainJob.ve_class = @ManyGoalsValueEstimator